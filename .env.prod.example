# =============================================================================
# grading.hrlab.uz — PRODUCTION environment template.
# =============================================================================
# Copy this to `.env.prod` ON THE VPS (NEVER commit the real .env.prod).
# `.env.prod` is git-ignored via `.env.*.local` patterns; double-check it is
# never staged. The CD pipeline writes/refreshes this file on the VPS from
# GitHub repo secrets (see .github/workflows/deploy.yml + the runbook).
#
# All values below are PLACEHOLDERS. Replace before first deploy.
# NO real secrets must ever land in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Image coordinates (set by CD; pinned to an IMMUTABLE tag — never `latest`).
# -----------------------------------------------------------------------------
# GHCR_REPO = "<owner>/<repo>" exactly as github.repository, lowercased by GHCR.
# For this repo: aziz-bek01/grading
GHCR_REPO=aziz-bek01/grading
# Immutable tag built by ci.yml. The CD pipeline injects sha-<short> of the
# deployed commit, e.g. IMAGE_TAG=sha-1a2b3c4. NEVER set this to `latest`.
IMAGE_TAG=sha-REPLACE_ME

# -----------------------------------------------------------------------------
# Dedicated grading Postgres (the isolated `grading-postgres` container).
# Only used when running the bundled DB (compose profile `db`). The bootstrap
# superuser OWNS the dedicated grading database; it is reachable only on the
# internal docker network (no host port). If you point at an EXTERNAL Postgres
# instead, you can leave these blank and skip the `db` profile.
# -----------------------------------------------------------------------------
POSTGRES_DB=grading_control_db
POSTGRES_SUPER_USER=grading_owner
POSTGRES_SUPER_PASSWORD=REPLACE_ME_strong_owner_password

# Toggle: set true to use an EXISTING/EXTERNAL Postgres already on the VPS
# (a SEPARATE database + SEPARATE roles from the other subdomains). When true,
# do NOT start the `db` profile; point the URLs below at that server's host.
GRADING_USE_EXTERNAL_DB=false

# -----------------------------------------------------------------------------
# Runtime datasource — app connects as grading_runtime (DML; INSERT+SELECT only
# on audit tables). F-04 role separation: NEVER reuse the migrator credential.
# Host inside the compose network = `grading-postgres`. For an external DB use
# its host:port (e.g. 172.17.0.1:5432 or the VPS LAN address) + a SEPARATE db.
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://grading-postgres:5432/grading_control_db
SPRING_DATASOURCE_USERNAME=grading_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_runtime_password

# -----------------------------------------------------------------------------
# Liquibase migrator datasource — connects as grading_migrator (DDL only).
# Used by the one-shot `grading-migrator` service. MUST be a different role +
# password from the runtime credential above.
# -----------------------------------------------------------------------------
LIQUIBASE_DATASOURCE_URL=jdbc:postgresql://grading-postgres:5432/grading_control_db
LIQUIBASE_DATASOURCE_USERNAME=grading_migrator
LIQUIBASE_DATASOURCE_PASSWORD=REPLACE_ME_migrator_password

# -----------------------------------------------------------------------------
# Audit-reader role password. Used only by the bundled-DB first-init bootstrap
# (infra/db/prod/01-create-prod-roles.sh). The audit-query path connects as
# grading_audit_reader (SELECT-only on audit tables). Keep it distinct.
# -----------------------------------------------------------------------------
GRADING_AUDIT_READER_PASSWORD=REPLACE_ME_audit_reader_password

# -----------------------------------------------------------------------------
# OAuth2 / OIDC — real JWT validation (issuer + audience). The API validates
# signature + iss + aud + exp. Point issuer-uri at your IdP's issuer (Keycloak,
# Auth0, etc.). Audience is comma-separated; default app value = grading.hrlab.uz.
# -----------------------------------------------------------------------------
GRADING_JWT_ISSUER_URI=https://auth.hrlab.uz/realms/grading
GRADING_JWT_AUDIENCE=grading.hrlab.uz

# -----------------------------------------------------------------------------
# CORS + tenancy. The SPA and API share the grading.hrlab.uz origin (the outer
# proxy splits /api vs /). Keep this pinned to the public HTTPS origin only.
# -----------------------------------------------------------------------------
GRADING_CORS_ALLOWED_ORIGINS=https://grading.hrlab.uz
# MVP 1 default tenancy = shared schema. Do NOT change without DB blueprint sign-off.
GRADING_TENANCY_MODE=shared

# -----------------------------------------------------------------------------
# Salary field encryption (MVP1 stub key id/version; real KMS lands in MVP3).
# -----------------------------------------------------------------------------
GRADING_SALARY_KEY_ID=prod-stub
GRADING_SALARY_KEY_VERSION=1

# -----------------------------------------------------------------------------
# IdP provisioning (decision doc 08, Option A — admin-set-password, NO SMTP).
# When ENABLED=true, an admin invite ALSO creates/links a ZITADEL login account
# (POST /v2/users/human, email pre-verified, password pre-set) so the invited
# user can sign in immediately via the OIDC flow with the admin-set password.
# Leave ENABLED=false to keep DB-only invites (no IdP side effects).
#
# GRADING_IDP_ZITADEL_TOKEN is a ZITADEL machine-user PAT — a HIGH-VALUE platform
# secret that can mint identities. NEVER commit it; keep it ONLY in this file on
# the VPS. Rotate per policy. The org id is the ZITADEL organization the human
# users are created under.
# -----------------------------------------------------------------------------
GRADING_IDP_ZITADEL_ENABLED=false
GRADING_IDP_ZITADEL_API_BASE=https://auth.hrlab.uz
GRADING_IDP_ZITADEL_ORG_ID=REPLACE_ME_zitadel_org_id
GRADING_IDP_ZITADEL_TOKEN=REPLACE_ME_zitadel_machine_user_pat

# -----------------------------------------------------------------------------
# JVM tuning for the API (sized for the enforced mem_limit on a 2GB shared VPS).
# Heap = MaxRAMPercentage of the container mem_limit (820m) -> ~508MB max heap.
# Metaspace + code cache are capped so total RSS stays under 820m (no OOM-kill).
# SerialGC has the smallest footprint/overhead for a sub-512MB heap on 1 vCPU.
# This MUST stay in sync with docker-compose.prod.yml's grading-api mem_limit:
# if you change mem_limit, re-check MaxRAMPercentage so heap stays ~60-65%.
# -----------------------------------------------------------------------------
API_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=62.0 -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=96m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# -----------------------------------------------------------------------------
# Object storage (MinIO) — OPT-IN, default OFF. Leave this whole block as-is to
# keep the api on local-FS storage (nothing changes; the grading-minio service
# never starts). The deploy stays green with the default.
#
# OPERATOR RUNBOOK — enable MinIO (do this ON THE VPS, in /opt/grading/.env.prod):
#   1. Set STRONG, UNIQUE credentials (NOT the placeholders below). Example:
#        MINIO_ROOT_USER=grading_s3_$(openssl rand -hex 4)
#        MINIO_ROOT_PASSWORD=$(openssl rand -base64 30)
#      These double as the api's S3 access/secret key. NEVER commit them.
#   2. Flip the switch:
#        GRADING_STORAGE_TYPE=minio
#   3. (optional) Override the bucket / region if desired (defaults: grading /
#      us-east-1). The bucket AUTO-CREATES on first use — no manual step.
#   4. Redeploy (push to main, or re-run the deploy workflow). The pipeline
#      detects GRADING_STORAGE_TYPE=minio, starts grading-minio (health-gated)
#      BEFORE rolling the api, then rolls the api/frontend as usual.
#
#   NOTE: pre-existing local-FS objects are NOT auto-migrated. After the flip,
#   NEW objects (reports/imports) go to MinIO; old local-FS objects stay where
#   they are (copy them manually if you need them in MinIO).
#
#   ROLLBACK — back to local-FS:
#     Unset or comment out GRADING_STORAGE_TYPE (or set it to `local`), then
#     redeploy. The api returns to local-FS storage; grading-minio is no longer
#     started. The grading-minio-data volume is retained (not deleted) so you
#     can re-enable later without data loss.
#
# SECURITY: MinIO's S3 API (:9000) is INTERNAL ONLY (the api reaches it at
# grading-minio:9000 over the private docker network — it is NOT published to
# the host). The web console (:9001) is bound to 127.0.0.1 ONLY on the VPS;
# reach it via an SSH tunnel (e.g. `ssh -L 9001:127.0.0.1:19001 vps`).
# -----------------------------------------------------------------------------
# Default OFF. Set to `minio` to route object storage to the MinIO service.
GRADING_STORAGE_TYPE=local
# MinIO root credentials — REQUIRED only when GRADING_STORAGE_TYPE=minio.
# Generate strong, unique values; these are also the api's S3 access/secret key.
MINIO_ROOT_USER=REPLACE_ME_minio_root_user
MINIO_ROOT_PASSWORD=REPLACE_ME_strong_minio_root_password
# Bucket + region (optional; sensible defaults baked into compose). The bucket
# auto-creates on first use.
MINIO_BUCKET=grading
MINIO_REGION=us-east-1

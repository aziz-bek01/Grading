# =============================================================================
# grading.hrlab.uz — PRODUCTION environment template.
# =============================================================================
# Copy this to `.env.prod` ON THE VPS (NEVER commit the real .env.prod).
# `.env.prod` is git-ignored via `.env.*.local` patterns; double-check it is
# never staged. The CD pipeline writes/refreshes this file on the VPS from
# GitHub repo secrets (see .github/workflows/deploy.yml + the runbook).
#
# All values below are PLACEHOLDERS. Replace before first deploy.
# NO real secrets must ever land in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Image coordinates (set by CD; pinned to an IMMUTABLE tag — never `latest`).
# -----------------------------------------------------------------------------
# GHCR_REPO = "<owner>/<repo>" exactly as github.repository, lowercased by GHCR.
# For this repo: aziz-bek01/grading
GHCR_REPO=aziz-bek01/grading
# Immutable tag built by ci.yml. The CD pipeline injects sha-<short> of the
# deployed commit, e.g. IMAGE_TAG=sha-1a2b3c4. NEVER set this to `latest`.
IMAGE_TAG=sha-REPLACE_ME

# -----------------------------------------------------------------------------
# Dedicated grading Postgres (the isolated `grading-postgres` container).
# Only used when running the bundled DB (compose profile `db`). The bootstrap
# superuser OWNS the dedicated grading database; it is reachable only on the
# internal docker network (no host port). If you point at an EXTERNAL Postgres
# instead, you can leave these blank and skip the `db` profile.
# -----------------------------------------------------------------------------
POSTGRES_DB=grading_control_db
POSTGRES_SUPER_USER=grading_owner
POSTGRES_SUPER_PASSWORD=REPLACE_ME_strong_owner_password

# Toggle: set true to use an EXISTING/EXTERNAL Postgres already on the VPS
# (a SEPARATE database + SEPARATE roles from the other subdomains). When true,
# do NOT start the `db` profile; point the URLs below at that server's host.
GRADING_USE_EXTERNAL_DB=false

# -----------------------------------------------------------------------------
# Runtime datasource — app connects as grading_runtime (DML; INSERT+SELECT only
# on audit tables). F-04 role separation: NEVER reuse the migrator credential.
# Host inside the compose network = `grading-postgres`. For an external DB use
# its host:port (e.g. 172.17.0.1:5432 or the VPS LAN address) + a SEPARATE db.
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://grading-postgres:5432/grading_control_db
SPRING_DATASOURCE_USERNAME=grading_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_runtime_password

# -----------------------------------------------------------------------------
# Liquibase migrator datasource — connects as grading_migrator (DDL only).
# Used by the one-shot `grading-migrator` service. MUST be a different role +
# password from the runtime credential above.
# -----------------------------------------------------------------------------
LIQUIBASE_DATASOURCE_URL=jdbc:postgresql://grading-postgres:5432/grading_control_db
LIQUIBASE_DATASOURCE_USERNAME=grading_migrator
LIQUIBASE_DATASOURCE_PASSWORD=REPLACE_ME_migrator_password

# -----------------------------------------------------------------------------
# Audit-reader role password. Used only by the bundled-DB first-init bootstrap
# (infra/db/prod/01-create-prod-roles.sh). The audit-query path connects as
# grading_audit_reader (SELECT-only on audit tables). Keep it distinct.
# -----------------------------------------------------------------------------
GRADING_AUDIT_READER_PASSWORD=REPLACE_ME_audit_reader_password

# -----------------------------------------------------------------------------
# OAuth2 / OIDC — real JWT validation (issuer + audience). The API validates
# signature + iss + aud + exp. Point issuer-uri at your IdP's issuer (Keycloak,
# Auth0, etc.). Audience is comma-separated; default app value = grading.hrlab.uz.
# -----------------------------------------------------------------------------
GRADING_JWT_ISSUER_URI=https://auth.hrlab.uz/realms/grading
GRADING_JWT_AUDIENCE=grading.hrlab.uz

# -----------------------------------------------------------------------------
# CORS + tenancy. The SPA and API share the grading.hrlab.uz origin (the outer
# proxy splits /api vs /). Keep this pinned to the public HTTPS origin only.
# -----------------------------------------------------------------------------
GRADING_CORS_ALLOWED_ORIGINS=https://grading.hrlab.uz
# MVP 1 default tenancy = shared schema. Do NOT change without DB blueprint sign-off.
GRADING_TENANCY_MODE=shared

# -----------------------------------------------------------------------------
# Salary field encryption (MVP1 stub key id/version; real KMS lands in MVP3).
# -----------------------------------------------------------------------------
GRADING_SALARY_KEY_ID=prod-stub
GRADING_SALARY_KEY_VERSION=1

# -----------------------------------------------------------------------------
# JVM tuning for the API (sized for a shared VPS; adjust to the box).
# -----------------------------------------------------------------------------
API_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# =============================================================
# grading.hrlab.uz — Repository-wide .gitignore
# =============================================================

# --- OS / Editor / IDE ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Logs & runtime ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local env / secrets ---
.env.local
.env.*.local
# Real production env file lives ONLY on the VPS (/opt/grading/.env.prod).
# Never commit it. The committed template is .env.prod.example (kept tracked).
.env.prod
!.env.prod.example
# GHCR read token stored on the VPS for private-image pulls.
.ghcr-token
**/application-secret.yml
**/application-prod.yml
*.pem
*.key
*.p12
*.pfx

# --- Java / Maven ---
backend/target/
**/*.class
**/hs_err_pid*
backend/.gradle/
backend/build/
backend/.maven/
backend/.mvn/wrapper/maven-wrapper.jar

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.eslintcache
frontend/playwright-report/
frontend/test-results/

# --- Docker / Kubernetes local state ---
**/*.dockerignore.local
infra/helm/*/charts/
infra/helm/*/Chart.lock

# --- Test artifacts ---
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/jacoco/

# --- Claude / agent runtime state ---
.claude/launch.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.codex/
**/agentId

# --- Local build / recovery scratch (never commit) ---
backend/cp.txt
frontend/scripts/_recovered_*.json

# --- Generated documentation ---
*.tmp.md

# --- Misc ---
*.bak
*.orig

# local prod DB copies (NEVER commit — real salary/PII)
.local-dumps/
.local-tools/

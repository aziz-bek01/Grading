<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>uz.hrlab</groupId>
    <artifactId>grading</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>grading.hrlab.uz</name>
    <description>HR Laboratories Grading SaaS — backend (modular monolith)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc-openapi 2.8.x is the line aligned with Spring Boot 3.5 /
             Spring Framework 6.2 (2.6.x targeted Boot 3.3). -->
        <springdoc.version>2.8.9</springdoc.version>
        <testcontainers.version>1.20.3</testcontainers.version>

        <!-- SEC-009 SCA-gate overrides of spring-boot-dependencies 3.5.14 pins that
             sit BELOW the Trivy "fixed" threshold. These re-pin every managed
             artifact in their family (tomcat-embed-*, org.postgresql:*, jackson-*,
             spring-*). Only raise, never lower — spring-security 6.5.10 already
             clears its threshold and stays BOM-managed. Re-check these on each
             Boot bump. -->
        <tomcat.version>10.1.55</tomcat.version>       <!-- BOM 10.1.54 → clears CVE set (incl. 3 CRITICAL) -->
        <postgresql.version>42.7.11</postgresql.version> <!-- BOM 42.7.10 → 42.7.11 -->
        <!-- spring-framework: BOM 6.2.18 stays vulnerable to CVE-2026-41850
             (spring-expression SpEL DoS), CVE-2026-41842 and CVE-2026-41845
             (spring-webmvc DoS/XSS) — all fixed in 6.2.19. Spring Boot honors
             this property to re-pin every spring-* framework module (spring-core,
             spring-web, spring-webmvc, spring-expression, ...) in lockstep. -->
        <spring-framework.version>6.2.19</spring-framework.version>
        <!-- jackson: the minio 8.6.0 transitive drags jackson-databind up to
             2.21.2, but CVE-2026-54512/54513 are only fixed at 2.21.4 in the
             2.21 branch (2.19.0–2.21.3 stay vulnerable). Pin the whole jackson
             BOM to 2.21.4 so every jackson-* module clears the threshold in
             lockstep (dependencyManagement wins over the transitive). -->
        <jackson-bom.version>2.21.4</jackson-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- SEC-009 — force Bouncy Castle up from the 1.78.1 that docx4j
                 (docx4j-JAXB-ReferenceImpl 11.5.1) drags in transitively. 1.78.1
                 carries a CRITICAL CVE; 1.81.1 clears it. docx4j only uses BC for
                 optional signing paths we do not exercise, so the bump is API-safe. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.81.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP — used by RlsTenantSessionAspect to set the RLS tenant GUC
             INSIDE the active @Transactional connection (see common.persistence). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Security + OAuth2 resource server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- BE-037 — MapStruct intentionally NOT used. This codebase maps by hand:
             every DTO carries an explicit static `from(...)` factory (44 mappers,
             e.g. PositionResponse.from(...), and the PanelLoader assembly pattern).
             Hand mapping is the deliberate, enforced convention here — it keeps
             tenant/salary field-stripping and localization decisions visible and
             greppable rather than hidden behind generated code. The MapStruct
             dependency + its annotation-processor path were removed after audit
             showed 0% usage; do NOT re-add them. -->

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MVP 2 Phase 3 — MinIO/S3 object storage SDK. Drives
             MinioObjectStorageAdapter (the real adapter behind
             grading.storage.type=minio). 8.6.0 (SEC-009 bump from 8.5.17, clears
             CVE-2025-59952) moves its bundled HTTP client to okhttp 5.1.0.
             MinioClient.builder() exposes okhttp3.HttpUrl in its API, so okhttp
             classes ARE required on the compile classpath. The client is built
             LAZILY (no network I/O in the constructor) so the one-shot `migrate`
             profile can instantiate this bean with MinIO unreachable and still
             exit cleanly (see MinioObjectStorageAdapter javadoc). -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>
        <!-- okhttp 5.x is a Kotlin-Multiplatform artifact: com.squareup.okhttp3:okhttp
             is an EMPTY 767-byte KMP stub whose JVM class files (incl.
             okhttp3.HttpUrl) live in okhttp-jvm. Maven resolves the .pom, not the
             Gradle-module metadata, so it pulls only the empty stub and the build
             fails with "class file for okhttp3.HttpUrl not found". spring-boot
             3.5.14 no longer manages okhttp, so pull the JVM variant explicitly,
             pinned to the exact version minio 8.6.0 was compiled against (avoids
             the okhttp 4→5 binary-incompatibility of forcing 4.x). Keep this
             version aligned with io.minio:minio's transitive okhttp on each bump. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Observability (Batch 6) — Prometheus scrape registry. Micrometer-core
             ships transitively with the actuator; this adds the Prometheus
             rendering registry so /actuator/prometheus can be exposed. The
             endpoint is exposed to the management surface but is NOT on the
             SecurityConfig public allowlist (see SecurityConfig.PUBLIC_PATHS) —
             metrics can leak tenant counts / operational data, so it requires
             auth / internal-network access. Only health + info stay public.
             Version is BOM-managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Caching (Caffeine) — tenant-safe, short-TTL cache for hot read-mostly
             dictionary lookups (role→permission expansion runs on every auth
             resolve). See uz.hrlab.grading.common.cache.CacheConfig for the
             tenant-isolation rationale and the bounded/expiry policy. Versions
             are BOM-managed by spring-boot-starter-parent (caffeine 3.1.8). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MVP 2 Phase 3 — Testcontainers MinIO module for the CI-only
             (@Tag("integration")) round-trip test of MinioObjectStorageAdapter.
             Version is managed by the testcontainers-bom above. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit — enforces architectural rules from master plan §21 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- MVP 2 Phase 2 — Excel import/export (Apache POI streaming) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- MVP 2 Phase 3 — PDF report generation (OpenPDF, com.lowagie.text.*).
             The PdfBuilder writes directly against OpenPDF; there is no
             JasperReports dependency (the old net.sf.jasperreports artifact was
             unused — 0 imports — and was removed in SEC-009, which also cleared
             its transitive commons-beanutils 1.9.4 CVE). If .jrxml templating is
             ever needed, add JasperReports back then. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.41</version>
        </dependency>

        <!-- MVP 2 Phase 3 — DOCX report generation (docx4j). -->
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-core</artifactId>
            <version>11.5.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-jdk14</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
            <version>11.5.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- No annotationProcessorPaths: BE-037 removed the MapStruct
                         processor (0% used; hand-written `from(...)` mappers are the
                         convention). -parameters stays for Spring/Jackson param names. -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
              JUnit 5 tag filtering — wired so CI can run dedicated release-gate
              packs (tenant-isolation / audit / salary / architecture) via the
              `-Dgroups=<tag>` system property. Default `mvn test` runs every
              test (Surefire); CI overrides on a per-gate job basis.

              Example CI invocations:
                ./mvnw -B test -Dgroups=tenant-isolation
                ./mvnw -B test -Dgroups=audit
                ./mvnw -B test -Dgroups=salary
                ./mvnw -B test -Dgroups=architecture
                ./mvnw -B test -DexcludedGroups=integration   (fast PR feedback)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tag filters come from -Dgroups / -DexcludedGroups on the CLI. -->
                    <argLine>-Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

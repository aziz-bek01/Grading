<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>uz.hrlab</groupId>
    <artifactId>grading</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>grading.hrlab.uz</name>
    <description>HR Laboratories Grading SaaS — backend (modular monolith)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.6.0</springdoc.version>
        <testcontainers.version>1.20.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP — used by RlsTenantSessionAspect to set the RLS tenant GUC
             INSIDE the active @Transactional connection (see common.persistence). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Security + OAuth2 resource server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- BE-037 — MapStruct intentionally NOT used. This codebase maps by hand:
             every DTO carries an explicit static `from(...)` factory (44 mappers,
             e.g. PositionResponse.from(...), and the PanelLoader assembly pattern).
             Hand mapping is the deliberate, enforced convention here — it keeps
             tenant/salary field-stripping and localization decisions visible and
             greppable rather than hidden behind generated code. The MapStruct
             dependency + its annotation-processor path were removed after audit
             showed 0% usage; do NOT re-add them. -->

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MVP 2 Phase 3 — MinIO/S3 object storage SDK. Drives
             MinioObjectStorageAdapter (the real adapter behind
             grading.storage.type=minio). 8.5.17 is the latest stable in the
             8.5.x line and pins okhttp 4.12.0, which spring-boot-dependencies
             3.3.4 already manages — so no HTTP-client version skew. The client
             is built LAZILY (no network I/O in the constructor) so the one-shot
             `migrate` profile can instantiate this bean with MinIO unreachable
             and still exit cleanly (see MinioObjectStorageAdapter javadoc). -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Observability (Batch 6) — Prometheus scrape registry. Micrometer-core
             ships transitively with the actuator; this adds the Prometheus
             rendering registry so /actuator/prometheus can be exposed. The
             endpoint is exposed to the management surface but is NOT on the
             SecurityConfig public allowlist (see SecurityConfig.PUBLIC_PATHS) —
             metrics can leak tenant counts / operational data, so it requires
             auth / internal-network access. Only health + info stay public.
             Version is BOM-managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Caching (Caffeine) — tenant-safe, short-TTL cache for hot read-mostly
             dictionary lookups (role→permission expansion runs on every auth
             resolve). See uz.hrlab.grading.common.cache.CacheConfig for the
             tenant-isolation rationale and the bounded/expiry policy. Versions
             are BOM-managed by spring-boot-starter-parent (caffeine 3.1.8). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MVP 2 Phase 3 — Testcontainers MinIO module for the CI-only
             (@Tag("integration")) round-trip test of MinioObjectStorageAdapter.
             Version is managed by the testcontainers-bom above. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit — enforces architectural rules from master plan §21 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- MVP 2 Phase 2 — Excel import/export (Apache POI streaming) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- MVP 2 Phase 3 — PDF report generation (OpenPDF; Jasper kept for future .jrxml). -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>6.21.3</version>
            <exclusions>
                <exclusion>
                    <groupId>com.lowagie</groupId>
                    <artifactId>itext</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jdt</groupId>
                    <artifactId>ecj</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.41</version>
        </dependency>

        <!-- MVP 2 Phase 3 — DOCX report generation (docx4j). -->
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-core</artifactId>
            <version>11.5.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-jdk14</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
            <version>11.5.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- No annotationProcessorPaths: BE-037 removed the MapStruct
                         processor (0% used; hand-written `from(...)` mappers are the
                         convention). -parameters stays for Spring/Jackson param names. -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
              JUnit 5 tag filtering — wired so CI can run dedicated release-gate
              packs (tenant-isolation / audit / salary / architecture) via the
              `-Dgroups=<tag>` system property. Default `mvn test` runs every
              test (Surefire); CI overrides on a per-gate job basis.

              Example CI invocations:
                ./mvnw -B test -Dgroups=tenant-isolation
                ./mvnw -B test -Dgroups=audit
                ./mvnw -B test -Dgroups=salary
                ./mvnw -B test -Dgroups=architecture
                ./mvnw -B test -DexcludedGroups=integration   (fast PR feedback)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tag filters come from -Dgroups / -DexcludedGroups on the CLI. -->
                    <argLine>-Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

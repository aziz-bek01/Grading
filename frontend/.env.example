# API base URL — dev defaults to /api/v1 proxied by Vite to VITE_API_PROXY (default http://localhost:8080).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY=http://localhost:8080
VITE_DEFAULT_LOCALE=ru-RU
VITE_DEV_AUTH=true
# Enable in-process mock adapter for Phase 2 endpoints (projects, departments, positions, workflow-progress).
VITE_USE_MSW=false

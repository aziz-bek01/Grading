# Production build env (auto-loaded by `vite build`).
# Dev auth (buildDevUser buttons + X-Dev-* headers) MUST be disabled in prod:
# the real OIDC flow against ZITADEL is the only login path.
VITE_DEV_AUTH=false
# No in-browser mock adapter in production — the real backend serves /api/v1.
VITE_USE_MSW=false

# =============================================================================
# auth.hrlab.uz — ZITADEL IdP environment template.
# =============================================================================
# Copy this to `.env.idp` ON THE VPS next to docker-compose.idp.yml (e.g.
# /opt/idp/.env.idp). NEVER commit the real .env.idp — it holds the masterkey,
# DB password and admin bootstrap password.
#
#   cp .env.idp.example .env.idp && chmod 600 .env.idp && nano .env.idp
#
# All values below are PLACEHOLDERS. Replace every REPLACE_ME before bring-up.
# =============================================================================

# -----------------------------------------------------------------------------
# Image — pin an IMMUTABLE ZITADEL version tag (never `latest`). Bump
# deliberately after reading the release notes; ZITADEL runs DB migrations on
# `setup` between versions.
# -----------------------------------------------------------------------------
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v2.66.1

# -----------------------------------------------------------------------------
# MASTERKEY — symmetric key ZITADEL uses to encrypt secrets at rest (32 bytes,
# EXACTLY 32 characters). Generate ONCE and keep it forever + back it up:
#   openssl rand -base64 24 | head -c 32 ; echo
# Or any 32-char string. If you LOSE this, encrypted data is unrecoverable.
# NEVER rotate casually — see README-runbook.md §5.
# -----------------------------------------------------------------------------
ZITADEL_MASTERKEY=REPLACE_ME_EXACTLY_32_CHARACTERS_

# -----------------------------------------------------------------------------
# External identity — how the WORLD reaches ZITADEL. TLS is terminated at the
# host nginx (certbot), NOT in the container, so:
#   ExternalSecure=true  -> ZITADEL emits https:// URLs (issuer, endpoints).
#   TLS_ENABLED=false    -> the container itself serves plain h2c on :8080;
#                           nginx does the HTTPS and forwards X-Forwarded-Proto.
#   ExternalPort=443     -> the public port behind nginx (NOT the container port).
# RESULT: the OIDC issuer ZITADEL publishes is exactly  https://auth.hrlab.uz
#         (the BARE domain — ZITADEL does NOT use Keycloak-style /realms/... ).
# -----------------------------------------------------------------------------
ZITADEL_EXTERNALDOMAIN=auth.hrlab.uz
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true
ZITADEL_TLS_ENABLED=false

# Trust the host nginx as the TLS terminator / forwarded-header source.
# (ZITADEL honours X-Forwarded-Proto/Host from the reverse proxy.)
ZITADEL_PORT=8080

# -----------------------------------------------------------------------------
# Database — REUSE the existing grading-postgres instance (saves a 2nd Postgres
# process). ZITADEL gets its OWN database + OWN roles inside that instance; it
# NEVER touches grading_control_db. Create them once per README-runbook.md §2.
#
# Host = the docker service name on the shared grading-prod network.
# SSL mode disable: traffic stays on the internal bridge network (not exposed).
#
#   * User (runtime, unprivileged): zitadel / <password>
#   * Admin (one-shot DDL on init/setup only): zitadel_admin / <password>
#     -> If you'd rather not create a dedicated admin role, point the ADMIN_*
#        vars at the grading-postgres superuser (grading_owner) JUST for the
#        init/setup one-shots, then never use it again. The dedicated role is
#        cleaner; see the runbook.
# -----------------------------------------------------------------------------
ZITADEL_DATABASE_POSTGRES_HOST=grading-postgres
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=zitadel

ZITADEL_DATABASE_POSTGRES_USER_USERNAME=zitadel
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=REPLACE_ME_zitadel_runtime_password
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=disable

ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=zitadel_admin
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=REPLACE_ME_zitadel_admin_password
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=disable

# -----------------------------------------------------------------------------
# First-instance bootstrap (created once by `zitadel setup`). This is the
# break-glass admin for the whole IdP. Use a strong password; ZITADEL will force
# a change + offer MFA on first console login. Store the credential in your
# secret manager / password vault.
# -----------------------------------------------------------------------------
ZITADEL_FIRSTINSTANCE_ORG_NAME=HRLab
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=REPLACE_ME_strong_admin_password
# Email for the admin (used for notifications / verification).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=az.asqarov@gmail.com
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_VERIFIED=true
# Do not force a password change on first login while bootstrapping (set true
# later for real human admins if you prefer).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED=false

# -----------------------------------------------------------------------------
# Resource hygiene for the 2 GB box. Keep ZITADEL's own caches/limits modest.
# (Optional knobs; safe defaults shown.)
# -----------------------------------------------------------------------------
# Lower the log noise; structured JSON for the host log pipeline.
ZITADEL_LOGSTORE_ACCESS_STDOUT_ENABLED=true
ZITADEL_LOG_LEVEL=info
ZITADEL_LOG_FORMAT=json
